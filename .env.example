# DesendividAÍ — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.

# ── IBM Cloud ──────────────────────────────────────────────────────────────────
IBM_CLOUD_ACCOUNT_ID=
IBM_CLOUD_REGION=

# Service ID criado para os agentes (desendividai-agents)
# API Key gerada via: ibmcloud iam service-api-key-create
IBM_CLOUD_API_KEY=

# ── watsonx.ai (WML) ───────────────────────────────────────────────────────────
WATSONX_URL=
WATSONX_INSTANCE_ID=
# Project ID: obtido em Watson Studio → projeto → Manage → General → Project ID
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Watson Studio ─────────────────────────────────────────────────────────────
WATSON_STUDIO_INSTANCE_ID=

# ── watsonx.governance ────────────────────────────────────────────────────────
WATSONX_GOV_INSTANCE_ID=
WATSONX_GOV_URL=

# ── Cloudant (substitui MongoDB nesta conta de hackathon) ─────────────────────
# Credencial gerada via: ibmcloud resource service-key-create desendividai-cloudant-key Gerente
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB_SNAPSHOTS=financial_snapshots
CLOUDANT_DB_CONSENTS=consent_registry

# ── Cloud Object Storage ──────────────────────────────────────────────────────
COS_INSTANCE_ID=
COS_BUCKET_REGION=us-south
COS_BUCKET_NAME=desendividai-artifacts
# Credenciais HMAC: IBM Cloud Console → COS → Service credentials → incluir credenciais HMAC
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=
