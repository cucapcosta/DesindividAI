# DesendividAÍ — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.

# ── IBM Cloud ──────────────────────────────────────────────────────────────────
IBM_CLOUD_ACCOUNT_ID=
IBM_CLOUD_REGION=

# Service ID criado para os agentes (desendividai-agents)
# API Key gerada via: ibmcloud iam service-api-key-create
IBM_CLOUD_API_KEY=

# ── watsonx.ai (WML) ───────────────────────────────────────────────────────────
WATSONX_URL=
WATSONX_INSTANCE_ID=
# Project ID: obtido em Watson Studio → projeto → Manage → General → Project ID
WATSONX_PROJECT_ID=
# Alternativa ao Project ID: ID de um espaço de implementação (tem precedência se definido)
WATSONX_SPACE_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Watson Studio ─────────────────────────────────────────────────────────────
WATSON_STUDIO_INSTANCE_ID=

# ── watsonx.governance ────────────────────────────────────────────────────────
WATSONX_GOV_INSTANCE_ID=
WATSONX_GOV_URL=

# ── Cloudant (substitui MongoDB nesta conta de hackathon) ─────────────────────
# Credencial gerada via: ibmcloud resource service-key-create desendividai-cloudant-key Gerente
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB_SNAPSHOTS=financial_snapshots
CLOUDANT_DB_CONSENTS=consent_registry
# Sem Cloudant, o M3 falha com 503. Só para desenvolvimento local: STORE_BACKEND=memory (dados perdem-se ao reiniciar;
# vale também para o cofre de identidade usado pelo POST /consent).
STORE_BACKEND=

# ── Cloud Object Storage ──────────────────────────────────────────────────────
COS_INSTANCE_ID=
COS_BUCKET_REGION=us-south
COS_BUCKET_NAME=desendividai-artifacts
# Credenciais HMAC: IBM Cloud Console → COS → Service credentials → incluir credenciais HMAC
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=

# ── Sub-Tarefa 3 (Motor de Simulação / Agente 2) ──────────────────────────────
# Endpoint do AI Service no watsonx.ai. Vazio = Motor executado localmente.
WATSONX_SIMULATION_URL=
# CET anual (% a.a.) assumido para a linha de consolidação BB (premissa, não oferta real)
BB_CONSOLIDATION_CET_ANNUAL=30
# Banco de simulações/recomendações/traces. Deve ser separado dos snapshots; padrão: decision_traces
CLOUDANT_DB_DECISIONS=
# Padrão: true (exige consentimento AUTHORISED do snapshot em /simulation e /recommendation).
# false só para demonstração com snapshots sem consentimento.
REQUIRE_CONSENT=true

# ── Agente 1 (M2) ─────────────────────────────────────────────────────────────
# Sem credenciais Open Finance/Serasa na conta do hackathon: simular cada fonte
# explicitamente com *_SANDBOX=true. O snapshot registra sources.<fonte>.sandbox.
# Cloudant e Granite são sempre reais.
OPEN_FINANCE_SANDBOX=
OPEN_FINANCE_BASE_URL=
OPEN_FINANCE_API_KEY=
SERASA_SANDBOX=
SERASA_BASE_URL=
SERASA_API_KEY=
# Segundos que GET /debts espera o agente antes de responder 202 PROCESSING.
DEBTS_SYNC_TIMEOUT_S=25
# Segundos que um resultado não buscado fica disponível antes de expirar.
DEBTS_RESULT_TTL_S=60
# Execuções simultâneas do Agente 1 por processo.
DEBTS_MAX_WORKERS=4

# ── Consentimento Open Finance (M1) ───────────────────────────────────────────
# true → redirect_url aponta para o próprio callback com code=sandbox (dev local)
OPEN_FINANCE_AUTH_SANDBOX=
# Base da URL do callback no modo sandbox (default: http://localhost:8000)
PUBLIC_BASE_URL=
# Modo real: endpoint /authorize do Authorization Server. Ausente e sem sandbox → 503
OPEN_FINANCE_AUTHORIZE_URL=
# Modo real: client_id registrado no API Connect
OPEN_FINANCE_CLIENT_ID=
# Modo real: redirect_uri registrado (aponta para /consent/callback via gateway)
OPEN_FINANCE_REDIRECT_URI=
# Endpoint POST /oauth/revoke do API Connect. Vazio → revogação de token é pulada (skipped)
OAUTH_REVOKE_URL=
# Token IAM do canal em POST/GET/DELETE /consent (sem API Connect). Padrão: exigido só com
# APP_ENV=production. O canal troca a API key do Service ID dele por um token IAM e manda
# "Authorization: Bearer <token>".
REQUIRE_CHANNEL_AUTH=
# iam_id dos Service IDs dos canais autorizados, separados por vírgula
# (ex.: iam-ServiceId-xxxxxxxx-...). Exigência ligada e lista vazia → 503 NOT_CONFIGURED.
CHANNEL_IAM_IDS=

# ── Pseudonimização (compartilhado M1/M2/M4) ──────────────────────────────────
# Chave HMAC-SHA256 em hex (>= 32 bytes). Gerar: python -c "import secrets; print(secrets.token_hex(32))"
# Obrigatória quando APP_ENV=production; em dev, ausência gera chave efêmera.
PSEUDONYM_HMAC_KEY=
APP_ENV=development

# ── M4 — Chaves, cofre de identidade, retenção e auditoria ───────────────────
# Versão ativa da chave de pseudonimização. v1 = PSEUDONYM_HMAC_KEY (já existente).
PSEUDONYM_KEY_ACTIVE_VERSION=v1
# Chave mestra (KEK) do cofre de identidade, 32 bytes em hex.
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_KEK_V1=
VAULT_KEK_ACTIVE_VERSION=v1
CLOUDANT_DB_IDENTITY_VAULT=identity_vault
CLOUDANT_DB_AUDIT=audit_trail
COS_AUDIT_PREFIX=audit/
RETENTION_AFTER_REVOCATION_DAYS=90
# Token dos endpoints /internal/* (gerar como as chaves acima)
INTERNAL_API_TOKEN=
