# DesendividAÍ — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.

# ── IBM Cloud ──────────────────────────────────────────────────────────────────
IBM_CLOUD_ACCOUNT_ID=
IBM_CLOUD_REGION=

# Service ID criado para os agentes (desendividai-agents)
# API Key gerada via: ibmcloud iam service-api-key-create
IBM_CLOUD_API_KEY=

# ── watsonx.ai (WML) ───────────────────────────────────────────────────────────
WATSONX_URL=
WATSONX_INSTANCE_ID=
# Project ID: obtido em Watson Studio → projeto → Manage → General → Project ID
WATSONX_PROJECT_ID=
# Alternativa ao Project ID: ID de um espaço de implementação (tem precedência se definido)
WATSONX_SPACE_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Watson Studio ─────────────────────────────────────────────────────────────
WATSON_STUDIO_INSTANCE_ID=

# ── watsonx.governance ────────────────────────────────────────────────────────
WATSONX_GOV_INSTANCE_ID=
WATSONX_GOV_URL=

# ── Cloudant (substitui MongoDB nesta conta de hackathon) ─────────────────────
# Credencial gerada via: ibmcloud resource service-key-create desendividai-cloudant-key Gerente
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB_SNAPSHOTS=financial_snapshots
CLOUDANT_DB_CONSENTS=consent_registry

# ── Cloud Object Storage ──────────────────────────────────────────────────────
COS_INSTANCE_ID=
COS_BUCKET_REGION=us-south
COS_BUCKET_NAME=desendividai-artifacts
# Credenciais HMAC: IBM Cloud Console → COS → Service credentials → incluir credenciais HMAC
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=

# ── Sub-Tarefa 3 (Motor de Simulação / Agente 2) ──────────────────────────────
# Endpoint do AI Service no watsonx.ai. Vazio = Motor executado localmente.
WATSONX_SIMULATION_URL=
# CET anual (% a.a.) assumido para a linha de consolidação BB (premissa, não oferta real)
BB_CONSOLIDATION_CET_ANNUAL=30
# Banco de simulações/recomendações/traces. Deve ser separado dos snapshots; padrão: decision_traces
CLOUDANT_DB_DECISIONS=
# true = exige consentimento AUTHORISED no consent_registry (ligar quando o /consent persistir)
REQUIRE_CONSENT=false

BOB_API_KEY=

# ── Agente 1 (M2) ─────────────────────────────────────────────────────────────
# Sem credenciais Open Finance/Serasa na conta do hackathon: simular cada fonte
# explicitamente com *_SANDBOX=true. O snapshot registra sources.<fonte>.sandbox.
# Cloudant e Granite são sempre reais.
OPEN_FINANCE_SANDBOX=
OPEN_FINANCE_BASE_URL=
OPEN_FINANCE_API_KEY=
SERASA_SANDBOX=
SERASA_BASE_URL=
SERASA_API_KEY=
# Segundos que GET /debts espera o agente antes de responder 202 PROCESSING.
DEBTS_SYNC_TIMEOUT_S=25
# Segundos que um resultado não buscado fica disponível antes de expirar.
DEBTS_RESULT_TTL_S=60
# Execuções simultâneas do Agente 1 por processo.
DEBTS_MAX_WORKERS=4

# ── Pseudonimização (compartilhado M1/M2/M4) ──────────────────────────────────
# Chave HMAC-SHA256 em hex (>= 32 bytes). Gerar: python -c "import secrets; print(secrets.token_hex(32))"
# Obrigatória quando APP_ENV=production; em dev, ausência gera chave efêmera.
PSEUDONYM_HMAC_KEY=
APP_ENV=development
